# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname of the API, pointing (DNS A record) at the server, e.g. api.safepath.example
API_DOMAIN=
# Where the website runs (Vercel URL or your domain), e.g. https://safepath.vercel.app
FRONTEND_ORIGIN=

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
SAFEPATH_HASH_SALT=
POSTGRES_PASSWORD=

# Cloudflare dashboard → Turnstile → Add widget (free). Secret key here; site key goes to the frontend.
TURNSTILE_SECRET=
