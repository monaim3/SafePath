# Copy to .env (or set in your host). Never commit real values.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty = local SQLite file. Production: postgres://user:password@host:5432/safepath
DATABASE_URL=

# Salt for hashing device IDs and IPs. Required in production; rotating it unlinks old hashes.
SAFEPATH_HASH_SALT=change-me

# Cloudflare Turnstile secret (free). Empty = CAPTCHA check skipped (development only).
TURNSTILE_SECRET=

# Number of reverse proxies in front of Django (e.g. 1 behind Caddy) so client IPs are read correctly.
TRUSTED_PROXY_COUNT=0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
