# Django API. Leave empty to run the frontend alone in demo mode (reports are not sent anywhere).
NEXT_PUBLIC_API_URL=http://localhost:8000
# "off" hides the demo-data notice. Keep it on while the backend only has `seed_demo` data.
NEXT_PUBLIC_DEMO_NOTICE=on
# Cloudflare Turnstile site key (free). Empty = no CAPTCHA widget (development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
